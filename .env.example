# ==============================================================================
# EDEL / EEL Environment Configuration Template
# Copy this file to .env and populate with your personal credentials.
# WARNING: NEVER commit .env to version control!
# ==============================================================================

# Embedding & LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_EMAIL=your_email@domain.com
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ------------------------------------------------------------------------------
# Exeter Erdos Server Configuration
# ------------------------------------------------------------------------------
ERDOS_HOST=erdos.ex.ac.uk
ERDOS_SSH_PORT=9022
ERDOS_USERNAME=your_username
ERDOS_PASSWORD=your_password

# ------------------------------------------------------------------------------
# IME USP Server Family Configuration
# ------------------------------------------------------------------------------
IME_SERVER=shell.vision.ime.usp.br
IME_USER=your_username
IME_PASSWORD=your_password
IME_COMPUTE_NODE=deeptwelve
IME_REPO_PATH=~/lcorreia/eel
